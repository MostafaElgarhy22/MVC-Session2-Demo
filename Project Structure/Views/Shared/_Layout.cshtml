<!DOCTYPE html>

<html>
<head>
    
        <meta name="viewport" content="width=device-width" />
        <title>@ViewBag.Title</title>
        <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
   
</head>
<body>


    @* Start Header *@
    <header class="mt-5">
        <centre></centre>
        <nav>
            <a href="/Home/Index" class="btn btn-primary">Home</a>
            <a href="/Home/AboutUs" class="btn btn-warning">About Us</a>
            <a href="/Home/Privacy" class="btn btn-success">Privacy</a>
            <a href="/Home/ContactUs" class="btn btn-light">Contact Us</a>

            <a href="/Account/SignIn" class="btn btn-info">Sign In</a>
            <a href="/Account/SignUp" class="btn btn-danger">Sign Up</a>

        </nav>


    </header>
    @* End Header *@

    @* Start Body *@
    <div>
        @RenderBody()
    </div>
    @* End Body *@


    @* Start Footer *@
    <footer>
        <centre>
            <div class="mt-3">
                <p> CopyRights &copy; Route @DateTime.Now.Year</p>
            </div>
        </centre>
    </footer>
    @* End Footer *@
</body>
</html>
